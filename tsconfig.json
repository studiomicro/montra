{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"allowJs": true,
		"checkJs": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"forceConsistentCasingInFileNames": true,
		"paths": { "#lib": ["./src/lib"], "#lib/*": ["./src/lib/*"] }
	},
	"include": ["src", "test", "e2e", "scripts", "*.ts"],
	"exclude": ["src/service-worker"]
}
