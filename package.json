{
	"name": "montra",
	"private": true,
	"license": "AGPL-3.0-only",
	"version": "0.17.0",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "node scripts/ocr-assets.ts && vite dev",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p src/service-worker/tsconfig.json && tsc -p workers/jobs/tsconfig.json && tsc -p workers/inbound/tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"posttest": "node scripts/clean-miniflare-tmp.ts",
		"clean:tmp": "node scripts/clean-miniflare-tmp.ts",
		"test:e2e": "playwright test",
		"build": "node scripts/ocr-assets.ts && vite build",
		"gates": "npm run check && npm run lint && npm run test && npm run build",
		"types:cf": "wrangler types src/worker-configuration.d.ts && wrangler types -c workers/jobs/wrangler.jsonc workers/jobs/worker-configuration.d.ts && wrangler types -c workers/inbound/wrangler.jsonc workers/inbound/worker-configuration.d.ts",
		"dev:workers": "wrangler dev -c wrangler.jsonc -c workers/jobs/wrangler.jsonc -c workers/inbound/wrangler.jsonc --persist-to .wrangler/state",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "node scripts/migrate-local.ts",
		"db:seed:local": "node scripts/seed-local.ts",
		"db:reset:local": "node scripts/reset-local.ts",
		"compat:statements": "node scripts/compat-statements.ts",
		"compat:senders": "node scripts/compat-senders.ts",
		"compat:receipts": "node scripts/compat-receipts.ts",
		"compat:tanya": "node scripts/compat-tanya.ts",
		"compat:agent": "node scripts/compat-agent.ts",
		"compat:ocr": "node scripts/compat-ocr.ts",
		"ocr:assets": "node scripts/ocr-assets.ts",
		"test:pdf-workerd": "node scripts/pdf-bound-workerd.ts",
		"deploy:staging": "node scripts/deploy-staging.ts",
		"prepare": "svelte-kit sync || echo ''"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261007.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@seriousme/openapi-schema-validator": "2.11.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.4",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.13.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.3",
		"vitest": "^5.0.3",
		"wrangler": "^4.148.0"
	},
	"dependencies": {
		"@noble/hashes": "2.4.0",
		"drizzle-orm": "^0.45.3",
		"fflate": "0.8.3",
		"pdfjs-dist": "6.4.299",
		"postal-mime": "4.0.8",
		"tesseract.js": "7.0.0",
		"tesseract.js-core": "7.0.0",
		"unpdf": "1.8.1",
		"zod": "^4.6.6"
	},
	"overrides": {
		"@esbuild-kit/core-utils": {
			"esbuild": "0.25.12"
		}
	}
}
